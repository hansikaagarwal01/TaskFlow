# TaskFlow Environment Variables Configuration Template
# Copy to .env for local development

NODE_ENV=development
PORT=5000

# PostgreSQL Database Connection String
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/taskflow?schema=public"

# Database Container Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=taskflow

# Security & Authentication Secrets
JWT_ACCESS_SECRET=taskflow-dev-access-token-secret-key-32bytes-minimum-security
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
AUTH_REFRESH_COOKIE=taskflow_refresh

# CORS Origin Allowed
CORS_ORIGIN=http://localhost:3000
